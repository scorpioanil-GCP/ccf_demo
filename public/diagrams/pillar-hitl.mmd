flowchart TD
    subgraph Triggers["Trigger sources"]
        Gate["Workflow HITL gate"]
        DcBreach["D_c threshold breach<br/>(CAR forced escalation)"]
        AgentOut["Agent output<br/>(value / generated content)"]
    end

    subgraph Primitives["HITL primitives"]
        ApprovalGate["ApprovalGate"]
        ExceptionEscalation["ExceptionEscalation"]
        OverrideBoundary["OverrideBoundary"]
        ReviewQueue["ReviewQueue"]
    end

    subgraph Transport["HITLTransportProtocol (D-IMPL-20)"]
