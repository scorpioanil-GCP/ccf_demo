# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# --- Fluree: relationships, temporal, lineage, policy binding ---------------
FLUREE_URL=http://192.168.4.76:8092
FLUREE_LEDGER=fibo:main

# --- Postgres: entities, policy reference, internal<->LEI crosswalk ---------
PGHOST=192.168.4.76
PGPORT=5432
PGDATABASE=parkavedb
PGUSER=parkave
PGPASSWORD=

# --- MongoDB: document text, passage spans, embeddings ---------------------
MONGO_URI=mongodb://192.168.4.76:27017
MONGO_DB=fibo

# --- SQLite: departmental store (local file, no server) --------------------
SQLITE_PATH=./data/departmental.sqlite

# --- Neo4j: OPTIONAL, graph algorithms only. May be dropped entirely. ------
NEO4J_URI=bolt://192.168.4.76:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Public data sources ---------------------------------------------------
# SEC requires a descriptive User-Agent with contact email or it will 403.
SEC_USER_AGENT=ccf-dataprep dcastilloaz@gmail.com
FRED_API_KEY=
COMPANIES_HOUSE_API_KEY=

# ===========================================================================
# CO-LENDER FABRIC — the second CCF instance (syndicated-lending-co-lender)
# ===========================================================================
#
# Leave the whole block unset until the peer instance is provisioned. Nothing
# falls back to the local fabric: a silent fallback would run a federation
# demonstration against a single store and report success.
#
# The boundary is enforced, not assumed. `ccf.config.assert_distinct_fabrics`
# refuses a peer that shares our database, our ROLE, or our ledger — see
# validators/test_fabric_isolation.py, which runs without the instance.
#
# Required: Fluree + Postgres. Optional: MongoDB.

# --- Peer Fluree ------------------------------------------------------------
# A different host is better than a different port: it makes the boundary
# visible in config, and lets §F's "federated request that times out" be
# produced by stopping a service rather than simulated.
#CO_LENDER_FLUREE_URL=http://192.168.4.76:8093
#CO_LENDER_FLUREE_LEDGER=colender-main

# --- Peer Postgres ----------------------------------------------------------
# Its OWN DATABASE, not a schema in ours — cross-schema joins are one
# search_path away. And its OWN ROLE, with no grant on parkavedb: a shared
# role can reach our data whether or not it is pointed at it today, which
# makes the boundary a convention rather than a control.
#CO_LENDER_PGHOST=192.168.4.77
#CO_LENDER_PGPORT=5432
#CO_LENDER_PGDATABASE=colenderdb
#CO_LENDER_PGUSER=colender
#CO_LENDER_PGPASSWORD=
#CO_LENDER_PG_SCHEMA=colender

# --- Peer MongoDB — OPTIONAL ------------------------------------------------
# Only if the peer's product carries its own passage lineage. Our side already
# holds the agreement text from EDGAR, so omit it unless that changes.
#CO_LENDER_MONGO_URI=mongodb://192.168.4.77:27017
#CO_LENDER_MONGO_DB=colender
