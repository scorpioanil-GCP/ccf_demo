# The controlled bank instance: the NAMES this instance reads. No value belongs in the repository.
# Copy to <instance root>/secrets/instance.env, fill in, chmod 0600, owned by the service account.

# Who may run this instance. launch.sh refuses any other user, and root.
CCF_SERVICE_ACCOUNT=

# The one bearer credential of the one entitlement cohort this instance serves (D-IMPL-343 door block).
CCF_CP_06C_DOOR_TOKEN=

# Approved non-production data, READ-ONLY. Use a role that holds SELECT and nothing else.
CCF_CP_06C_FLUREE_URL=
CCF_CP_06C_FLUREE_LEDGER=fibo-v2
CCF_CP_06C_POSTGRES_DSN=
CCF_CP_06C_POSTGRES_SCHEMA=ccf_v2
